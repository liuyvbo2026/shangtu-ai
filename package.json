  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "start:configured": "node scripts/start-configured.mjs",
    "check": "node --check src/app.js && node --check src/image.js && node --check src/model.js && node --check src/demo-service.js && node --check src/views.js && node --check src/glass.js && node --check src/controls.js && node scripts/check-batch.mjs && node scripts/check-workflow.mjs && node scripts/check-editor.mjs && node scripts/check-integration.mjs",
    "test": "node --test tests/*.test.mjs tests/stage2-batch.contract.mjs tests/backend/*.test.mjs tests/integration/*.test.mjs",
    "test:batch": "node --test tests/batch.test.mjs",
    "test:stage2": "node --test tests/stage2-batch.contract.mjs",
    "evidence:batch": "node scripts/record-06a-evidence.mjs",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check:integration": "node scripts/check-integration.mjs",
    "backup:backend": "node backend/maintenance.mjs backup",
    "restore:backend": "node backend/maintenance.mjs restore"
  },
  "engines": {
    "node": ">=22.18.0"
  }
